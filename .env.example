# PayPal sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Optional locally. Create a webhook pointing at {APP_URL}/api/paypal/webhook and paste its ID.
PAYPAL_WEBHOOK_ID=

# LLM: any OpenAI-compatible chat-completions endpoint with tool calling.
# Default is Groq's free tier (key from https://console.groq.com, no card needed).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Other providers, same three variables, for example Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash

# Public base URL of this app (PayPal redirects back here)
APP_URL=http://localhost:3000

# Set to 1 only in local development to enable POST /api/dev/purchase
ALLOW_DEV_ROUTES=0
